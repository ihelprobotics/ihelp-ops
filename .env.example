# Auth ---------------------------------------------------------------------
AUTH_SECRET=            # openssl rand -base64 32
AUTH_GOOGLE_ID=         # Google Cloud console -> OAuth client (Web)
AUTH_GOOGLE_SECRET=
AUTH_URL=http://localhost:3000        # in production: https://ops.yourdomain.com

# Database -----------------------------------------------------------------
DATABASE_URL=           # Neon connection string, pooled

# GitHub -------------------------------------------------------------------
GH_DISPATCH_TOKEN=      # fine-grained PAT: actions:write, contents:write, pull_requests:write
GH_WEBHOOK_SECRET=      # any random string; paste the same one into the webhook
OPS_REPO=your-org/ev-edge

# Platform -----------------------------------------------------------------
PLATFORM_URL=http://localhost:3000

# Cron and callbacks -------------------------------------------------------
CRON_SECRET=              # openssl rand -hex 24; Vercel Cron sends it as a Bearer token
AGENT_CALLBACK_SECRET=    # openssl rand -hex 24; same value as PLATFORM_WEBHOOK_SECRET in the code repo

# Email --------------------------------------------------------------------
RESEND_API_KEY=
MAIL_FROM=iHelp Ops <ops@ihelprobotics.com>
DIGEST_TO=                # comma-separated: the CTO and the delivery manager

# Reporting scope ----------------------------------------------------------
REPOS=                    # comma-separated repos for the digest; defaults to OPS_REPO
